# 개발 전용 — Anthropic API 키
#
# 이 파일을 `.env.local`로 복사하고 키를 넣으세요. `.env.local`은 .gitignore의
# `*.local`에 걸려 커밋되지 않습니다.
#
#   cp .env.example .env.local
#
# ⚠️ VITE_ 로 시작하는 값은 브라우저 번들에 그대로 실립니다. 이 상태로 배포하면
#    키가 공개됩니다. 배포 전에는 반드시 프록시 서버로 옮기세요.
#
# 키가 비어 있으면 앱은 지금처럼 코드만으로 돕니다 (LLM 없이 데모 동작).
VITE_ANTHROPIC_API_KEY=

# ── Supabase (새 프로젝트 — haksup과 별개) ────────────────────────────
# 대시보드 → Project Settings → API 에서 복사합니다.
# 둘 다 공개돼도 되는 값입니다(브라우저에 실립니다). 보호는 RLS가 합니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️ service_role 키는 여기 넣지 마세요. 브라우저에 실리면 RLS가 통째로 무력화됩니다.
#    Edge Function에서는 SUPABASE_SERVICE_ROLE_KEY 로 자동 주입되므로 복사할 일도 없습니다.

{
  "canvas": { "width": 390, "height": 844 },
  "product_character_name": "다정쌤",
  "prototype_character_name": "상냥한 선생님",
  "fonts": {
    "ui": "Noto Sans KR",
    "teacher_and_sentence": "Gowun Dodum"
  },
  "colors": {
    "stage_outside": "#1d1a1f",
    "classroom": "#f7efe6",
    "wall_top": "#f9f1e7",
    "wall_bottom": "#f3e6d8",
    "text": "#2b2430",
    "muted": "#8a7f88",
    "accent": "#ef7a93",
    "accent_hover": "#e2607d",
    "student_bubble": "#ef7a93",
    "whiteboard_border": "#d6d9dd"
  },
  "screens": {
    "chat": {
      "source": "학습첫화면_대답버튼.html",
      "use_for": ["intro", "reask", "binary_choice", "wrap_up"],
      "shows": ["classroom", "whiteboard", "character", "teacher_bubble_or_subtitle", "last_student_bubble", "quick_replies", "input_bar"],
      "input_placeholder": "선생님께 답해 보세요…",
      "default_quick_replies_examples": ["네, 좋아요!", "힌트 주세요", "다시 설명해 주세요"]
    },
    "study": {
      "source": "상냥쌤 문장 학습.html",
      "use_for": ["chunk_translation", "read_aloud"],
      "shows": ["progress_dots", "large_english_sentence", "listen", "small_teacher_bubble", "quick_replies", "input_bar"],
      "input_placeholder": "해석을 적어 보세요…",
      "default_quick_replies_examples": ["다 읽었어요", "힌트 주세요"]
    }
  },
  "transcript": {
    "teacher_lines_visible": 1,
    "student_lines_visible": 1
  },
  "maps_from_tutor_json": {
    "message": "teacher_bubble",
    "buttons": "quick_replies",
    "effect.light": "self_correction_highlight"
  }
}
